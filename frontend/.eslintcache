n    state={\r\n      \r\n    }\r\n    proxy_request(path)\r\n    {\r\n        this.props.parent.fetch_update(path);\r\n    }\r\n    componentDidMount(){\r\n        \r\n    }\r\n    isPrintable(char)\r\n    {\r\n        return(' '.charCodeAt(0)<=char &&char<='~'.charCodeAt(0));\r\n    }\r\n\r\n    make_item_view(address, value){\r\n        let ascii=\"\"\r\n        if (this.isPrintable(value))        \r\n        {ascii=<td className=\"asciivalue memvalue\">'{String.fromCharCode(value)}'</td> }\r\n        else\r\n        {ascii=<td className=\"asciivalue memvalue\">'<span style={{color:\"gray\",opacity:0.5}}>•</span>'</td> }\r\n        if(address===\"...\")\r\n        {\r\n            return(\r\n                <tr className=\"mem_singles\">\r\n                <td className=\"address\">\r\n                    ....\r\n                </td>\r\n                <td className=\"memvalue\">\r\n\r\n                </td>\r\n            </tr>\r\n            )\r\n        }\r\n        else\r\n        \r\n        return(\r\n            <tr className=\"mem_singles\">\r\n                <td className=\"address\">\r\n                    {parseInt(address).toString(16).padStart(4,'0').toUpperCase()+\"H\"}\r\n                </td>\r\n                    <td className=\"hexvalue memvalue\">{value.toString(16).padStart(2,'0').toUpperCase()}h</td>\r\n                    <td className=\"decvalue memvalue\">{value}</td>\r\n                    {ascii}\r\n            </tr>\r\n        )\r\n    }\r\n    get_memory_item_views(){\r\n        let memory_items=[]\r\n        let next=0;\r\n        for(let base_addr in this.props.memory)\r\n        {\r\n            base_addr=parseInt(base_addr)\r\n            let i=0;\r\n            // console.log(next,base_addr)\r\n            if(next!==base_addr)\r\n                memory_items.push(this.make_item_view(\"...\",null))\r\n            for(let _ in this.props.memory[base_addr])\r\n            {\r\n                base_addr=parseInt(base_addr)\r\n                let mem_item=this.make_item_view(base_addr+i,this.props.memory[base_addr][i])   \r\n                memory_items.push(mem_item);   \r\n                i++;          \r\n            }\r\n            next=base_addr+i;\r\n        }\r\n        if(next!==65536)\r\n            memory_items.push(this.make_item_view(\"...\",null))\r\n        return memory_items;\r\n    }\r\n    writemem=e=>{\r\n        fetch(\"/writemem\",{\r\n            method:\"POST\",\r\n            headers:{\r\n                \"Content-Type\":\"application/json\"\r\n            },\r\n            body:JSON.stringify({\r\n                \"addr\":this.addr_write.current.value,\r\n                \"value\":this.value_write.current.value\r\n            })\r\n        })\r\n        .then(res=>res.json()).then(\r\n            data=>{\r\n              this.props.parent.setState({\"registers\":data[\"registers\"],\r\n              \"memory\":data[\"memory\"],\r\n              \"port\":data[\"ports\"]})\r\n              this.addr_write.current.value=\"\";\r\n              this.value_write.current.value=\"\";\r\n            }\r\n          )\r\n    }\r\n    render(){\r\n        \r\n        return(\r\n        <div className=\"memoryview\">\r\n            <div className=\"heading\">\r\n                Memory\r\n            </div>\r\n            <div className=\"body\">\r\n                <table>\r\n            {this.get_memory_item_views()}\r\n            </table>\r\n            </div>\r\n            <div className=\"inprow\">\r\n            <input type=\"text\" placeholder=\"Address\" ref={this.addr_write}></input>\r\n            <input type=\"text\" placeholder=\"Value\" ref={this.value_write}></input>\r\n            <button onClick={this.writemem}>\r\n                <img src={send} alt= \"send icon\"></img>\r\n            </button>\r\n            </div>\r\n        </div>\r\n        )\r\n    }\r\n}\r\n\r\nexport default memoryview;","C:\\Users\\DaringJoker\\Documents\\programming\\react\\emulator\\frontend\\src\\Components\\portsView\\main.js",["126"],"import React ,{Component}from 'react'\r\nimport \"./ports.css\"\r\nimport send from \"../memoryView/send.png\"\r\n\r\nexport class Portsview extends Component\r\n{\r\n    addr_write=React.createRef()\r\n    value_write=React.createRef()  \r\n    state={\r\n      \r\n    }\r\n    proxy_request(path)\r\n    {\r\n        this.props.parent.fetch_update(path);\r\n    }\r\n    componentDidMount(){\r\n        \r\n    }\r\n    isPrintable(char)\r\n    {\r\n        return(' '.charCodeAt(0)<=char &&char<='~'.charCodeAt(0));\r\n    }\r\n\r\n    make_item_view(address, value){\r\n        let ascii=\"\"\r\n        if (this.isPrintable(value))        \r\n        {ascii=<td className=\"asciivalue portvalue\">'{String.fromCharCode(value)}'</td> }\r\n        else\r\n        {ascii=<td className=\"asciivalue portvalue\">'<span style={{color:\"gray\",opacity:0.5}}>•</span>'</td> }\r\n        if(address===\"...\")\r\n        {\r\n            return(\r\n                <tr className=\"port_singles\">\r\n                <td className=\"address\">\r\n                    ....\r\n                </td>\r\n                <td className=\"value\">\r\n\r\n                </td>\r\n            </tr>\r\n            )\r\n        }\r\n        else\r\n        \r\n        return(\r\n            <tr className=\"port_singles\">\r\n                <td className=\"address\">\r\n                    {parseInt(address).toString(16).padStart(2,'0').toUpperCase()+\"H\"}\r\n                </td>\r\n                    <td className=\"hexvalue portvalue\">{value.toString(16).padStart(2,'0').toUpperCase()}h</td>\r\n                    <td className=\"decvalue portvalue\">{value}</td>\r\n                    {ascii}\r\n            </tr>\r\n        )\r\n    }\r\n    get_port_item_view(){\r\n        let memory_items=[]\r\n        let next=0\r\n        for(let base_addr in this.props.ports)\r\n        {\r\n            base_addr=parseInt(base_addr)\r\n            let i=0;\r\n            if(next!==base_addr)\r\n                memory_items.push(this.make_item_view(\"...\",null))\r\n            for(let _ in this.props.ports[base_addr])\r\n            {\r\n                let mem_item=this.make_item_view(base_addr+i,this.props.ports[base_addr][i])   \r\n                memory_items.push(mem_item);   \r\n                i++;          \r\n            }\r\n            next=base_addr+i;\r\n        }\r\n        if(next!==65536)\r\n            memory_items.push(this.make_item_view(\"...\",null))\r\n\r\n        return memory_items;\r\n    }\r\n    writemem=e=>{\r\n        fetch(\"/writeport\",{\r\n            method:\"POST\",\r\n            headers:{\r\n                \"Content-Type\":\"application/json\"\r\n            },\r\n            body:JSON.stringify({\r\n                \"addr\":this.addr_write.current.value,\r\n                \"value\":this.value_write.current.value\r\n            })\r\n        })\r\n        .then(res=>res.json()).then(\r\n            data=>{\r\n              this.props.parent.setState({\"registers\":data[\"registers\"],\r\n              \"memory\":data[\"memory\"],\r\n              \"port\":data[\"ports\"]})\r\n              this.addr_write.current.value=\"\";\r\n              this.value_write.current.value=\"\";\r\n            }\r\n          )\r\n    }\r\n    render(){\r\n        return(\r\n        <div className=\"portsview\">\r\n            <div className=\"heading\">\r\n                Ports\r\n            </div>\r\n            <div className=\"body\">\r\n            <table>\r\n            {this.get_port_item_view()}\r\n            </table>\r\n            </div>\r\n            <div className=\"inprow\">\r\n            <input type=\"text\" placeholder=\"Address\" ref={this.addr_write}></input>\r\n            <input type=\"text\" placeholder=\"Value\" ref={this.value_write}></input>\r\n            <button onClick={this.writemem}>\r\n                <img src={send} alt= \"send icon\"></img>\r\n            </button>\r\n            </div>\r\n        </div>\r\n        )\r\n    }\r\n}\r\n\r\nexport default Portsview;","C:\\Users\\DaringJoker\\Documents\\programming\\react\\emulator\\frontend\\src\\Components\\stacksView\\main.js",[],"C:\\Users\\DaringJoker\\Documents\\programming\\react\\emulator\\frontend\\src\\Components\\consoleview\\main.js",[],"C:\\Users\\DaringJoker\\Documents\\programming\\react\\emulator\\frontend\\src\\Components\\tabbar\\main.js",[],"C:\\Users\\DaringJoker\\Documents\\programming\\react\\emulator\\frontend\\src\\Components\\statusbar\\main.js",[],{"ruleId":"127","replacedBy":"128"},{"ruleId":"129","replacedBy":"130"},{"ruleId":"127","replacedBy":"131"},{"ruleId":"129","replacedBy":"132"},{"ruleId":"127","replacedBy":"133"},{"ruleId":"129","replacedBy":"134"},{"ruleId":"127","replacedBy":"135"},{"ruleId":"129","replacedBy":"136"},{"ruleId":"137","severity":1,"message":"138","line":54,"column":83,"nodeType":"139","messageId":"140","endLine":54,"endColumn":85},{"ruleId":"141","severity":1,"message":"142","line":96,"column":21,"nodeType":"143","endLine":96,"endColumn":31},{"ruleId":"141","severity":1,"message":"142","line":97,"column":21,"nodeType":"143","endLine":97,"endColumn":31},{"ruleId":"141","severity":1,"message":"142","line":108,"column":21,"nodeType":"143","endLine":108,"endColumn":31},{"ruleId":"141","severity":1,"message":"142","line":109,"column":21,"nodeType":"143","endLine":109,"endColumn":31},{"ruleId":"141","severity":1,"message":"142","line":104,"column":5,"nodeType":"143","endLine":104,"endColumn":24},{"ruleId":"141","severity":1,"message":"142","line":105,"column":5,"nodeType":"143","endLine":105,"endColumn":24},{"ruleId":"141","severity":1,"message":"142","line":106,"column":5,"nodeType":"143","endLine":106,"endColumn":24},{"ruleId":"141","severity":1,"message":"142","line":107,"column":5,"nodeType":"143","endLine":107,"endColumn":15},{"ruleId":"141","severity":1,"message":"142","line":125,"column":5,"nodeType":"143","endLine":12